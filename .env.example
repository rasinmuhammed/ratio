# Copy to .env and fill in what you need. Nothing here is loaded unless
# LLM_PROVIDER selects it, so you only need one provider's key to run
# scripts/ask.py or the API server, not all of them.

# Which provider get_llm() returns. Unset defaults to groq.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

INCEPTION_API_KEY=
MERCURY_MODEL=mercury-2
MERCURY_REASONING_EFFORT=

TOKEN_ROUTER_API_KEY=
TOKEN_ROUTER_MODEL=z-ai/glm-5.3-free

IFM_API_KEY=
IFM_MODEL=IFM/K2-Horizon-375B-A23B

VOYAGE_API_KEY=

# --- API server (src/rag/api.py) ---

# Which local index directory to load. Defaults to data/index (6,476
# chunks); see the note in README.md about why that's the current
# default rather than the full corpus.
RATIO_INDEX_DIR=data/index

# HF Hub dataset repo to pull the index from if RATIO_INDEX_DIR doesn't
# already exist on disk. Only relevant on a fresh deploy target; unset
# and unused for local development. Build one with
# scripts/upload_index_to_hf.py.
RATIO_INDEX_REPO=

# Comma-separated list of frontend origins allowed to call the API.
# Unset (the default) allows every origin, fine for local development,
# not for a public deploy once the real frontend URL is known.
RATIO_ALLOWED_ORIGINS=
